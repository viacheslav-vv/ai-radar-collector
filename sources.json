    },
    {
      "name": "TechCrunch AI",
      "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
      "kind": "news"
    }
  ],
  "anthropic": {
    "enabled": true,
    "_comment": "No RSS; scrapes anthropic.com/news cards."
  }
}